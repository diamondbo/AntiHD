@inherits LayoutComponentBase

<data name="viewport" content="width=device-width, initial-scale=1.0" />

<div class="container">
    <div class="row">
        <div class="col-md-2" style="border-right: 1px solid #ccc;">
            <h1>AntiHD</h1>
        </div>
        <div class="col-md-10">
            <div class="web-hero"></div>
