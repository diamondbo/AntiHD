@page "/create-user-test"
@using AntiHD.Models
@using AntiHD.Shared.Services

@inject IUserServices UServ

@if(!string.IsNullOrEmpty(message))
{
    <div class="alert alert-success" role="alert">
        @message
    </div>
}

<EditForm Model="UserModel" OnValidSubmit="HandleCreateUser" FormName="CreateUserForm">
    <div class="mb-3">
    <label for="FirstName" class="form-label">First Name:</label>
        <InputText id="f_name" class="form-control" @bind-Value="UserModel.FirstName" />
    </div>
    <div class="mb-3">
    <label for="LastName" class="form-label">Last Name:</label>
        <InputText id="l_name" class="form-control" @bind-Value="UserModel.LastName" />
    </div>
    <div class="mb-3">
    <label for="UserName" class="form-label">User Name:</label>
        <InputText id="u_name" class="form-control" @bind-Value="UserModel.Username" />
    </div>
    <div class="mb-3">
    <label for="Password" class="form-label">Password:</label>
        <InputText id="password" type="password" class="form-control" @bind-Value="UserModel.Password" />
    </div>
    <div class="mb-3">
    <label for="Email" class="form-label">Email:</label>
        <InputText id="email" class="form-control" @bind-Value="UserModel.Email" />
    </div>
    
    <button type="submit" class="btn btn-primary mt-3">Create TestUser</button>

</EditForm>

@code{
    private Users UserModel {get; set; } = new Users(){Username = "default",Password = "default"};
    private string message = string.Empty;
    private async Task HandleCreateUser()
    {
        var result = await UServ.CreateUserAsync(UserModel);
        if(result == 0)
           throw new Exception("no rows changed");
        message = $"{result} rows updated";
    }
    
}