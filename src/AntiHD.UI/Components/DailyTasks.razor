@inherits LayoutComponentBase
<div class="card">
    <div class="card-header">
        <h6>Daily Tasks</h6>
    </div>
    <div class="card-body">
        <ul>
            @for (int i = 1; i <= numberOfTasks; i++)
            {
                <li>
                    <div class="row">
                        <div class="col-md-8">
                            <strong>Task @i</strong>
                            <p>Description of Task @i.</p>
                        </div>
                        <div class="col-md-4">
                            <input type="checkbox" @onchange="(e) => OnTaskCompleted(e, i)" />
                        </div>
                    </div>
                </li>
            }
            
        </ul>
    </div>
</div>

@code {
    [Parameter]
    public string description { get; set; } = "Daily Tasks";
    [Parameter]
    public int numberOfTasks { get; set; }
    public void OnTaskCompleted(ChangeEventArgs e, int taskId)
    {
        // Handle the event here
    }
}